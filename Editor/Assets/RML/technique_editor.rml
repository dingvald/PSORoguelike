<rml>
    <head>
        <title>Technique Editor</title>
        <link type="text/rcss" href="theme.rcss"/>
        <link type="text/rcss" href="field_widgets.rcss"/>
        <link type="text/rcss" href="content_editor.rcss"/>
    </head>
    <body>
        <div id="screen-list" class="screen">
            <div class="toolbar">
                <h1>Techniques</h1>
                <span id="new-technique" class="btn action">New Technique</span>
                <span id="list-error" class="text-danger"></span>
                <span id="back-to-menu" class="btn back">Back</span>
            </div>
            <div id="technique-list" class="scroll-panel"></div>
        </div>

        <div id="screen-edit" class="screen">
            <div class="toolbar">
                <span id="edit-title" class="title text-accent"></span>
                <span id="save-technique" class="btn action">Save</span>
                <span id="edit-dirty" class="text-accent"></span>
                <span id="edit-error" class="text-danger"></span>
                <span id="back-to-list" class="btn back">Back</span>
            </div>
            <div class="scroll-panel">
                <h3>Id</h3>
                <div id="field-id" class="field-row"></div>
                <h3>Name</h3>
                <div id="field-name" class="field-row"></div>
                <h3>TP Cost</h3>
                <div id="field-tp-cost" class="field-row"></div>
                <h3>Element</h3>
                <div id="field-element" class="field-row"></div>
                <h3>Targeting Mode</h3>
                <div id="field-targeting-mode" class="field-row"></div>
                <h3>Range Shape</h3>
                <div id="field-range-shape" class="field-row"></div>
                <h3>Range</h3>
                <div id="field-range" class="field-row"></div>
                <h3>Effect Family</h3>
                <div id="field-effect-family" class="field-row"></div>
                <h3>Status Effect</h3>
                <div id="field-status-effect" class="field-row"></div>
                <h3>Status Chance %</h3>
                <div id="field-status-chance" class="field-row"></div>
                <h3>Tiers <span id="add-tier" class="btn action">Add Tier</span></h3>
                <div id="tier-list" class="scroll-panel"></div>
            </div>
        </div>
    </body>
</rml>
