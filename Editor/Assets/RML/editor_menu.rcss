/* editor_menu.rcss -- layout only; colors/type come from theme.rcss. */

body {
    width: 100%;
    height: 100%;
}

#editor-menu-shell {
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

#editor-menu-panel {
    width: 420px;
    text-align: center;
}

.subtitle {
    margin-bottom: 1.2em;
}
