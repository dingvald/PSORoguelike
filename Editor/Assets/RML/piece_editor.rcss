/* Piece Editor's own styles, beyond the shared List/Edit shell in
   content_editor.rcss (linked before this file) -- the palette, per-cell
   inspector, stamped-prefab row list, and per-cell socket row list. */

/* content_editor.rcss's .grid-column is a single-child block box (just
   #preview-window at 100%/100%), shared with Dungeon/Prefab. Piece adds an
   orientation-preview control above the preview window (see #field-preview
   in piece_editor.rml), so this document-scoped override (RCSS rules are
   per-document, not global -- Dungeon/Prefab load their own separate .rml
   with no equivalent link) turns it into a flex column instead, with the new
   row fixed-height and the preview window filling the rest. */
.grid-column {
    display: flex;
    flex-direction: column;
}

#field-preview {
    flex: 0 0 auto;
    margin-bottom: 6px;
}

.preview-window {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
}

h3 .btn {
    margin-left: 8px;
}

/* Compact "+" add buttons for a socket's Tags/Connects To Tags lists --
   overrides theme.rcss's .btn { display: block; } (same specificity, later
   in the cascade) so they sit inline next to their h3 instead of forcing a
   full-width row. */
.add-socket-tag, .add-socket-connects {
    display: inline-block;
    width: 20px;
    padding: 0.3em 0;
    text-align: center;
}

/* One block-level wrapper around a socket row's fields/lists (see
   RefreshInspector) -- without it, those elements sit directly as children
   of .row-card-content (display: flex in field_widgets.rcss), where ones
   without an explicit full width (the h3 headers, the ref-scroll lists) size
   to their content and can land on the same flex line, overlapping instead
   of stacking. */
.socket-body {
    display: block;
    width: 100%;
}

.ref-scroll {
    display: block;
    width: 100%;
    box-sizing: border-box;
    max-height: 160px;
    overflow-y: auto;
    border: 1px #33363f;
    margin-bottom: 6px;
}

/* The generic field-label ("tag") is redundant here -- the socket's own
   "Tags"/"Connects To Tags" heading already says what the row holds.
   Hiding it (display: none, not just empty text) also drops it from
   .row-card-content's layout entirely, so the input becomes the row's only
   line and the drag-handle/remove-button (top-aligned via .row-card) land
   flush with it instead of the label line above. */
.tag-id .field-label {
    display: none;
}

.side-top {
    flex: 0 0 auto;
    max-height: 55%;
    box-sizing: border-box;
    overflow-y: auto;
}

.palette-scroll {
    flex: 1 1 auto;
    min-height: 0;
    box-sizing: border-box;
    overflow-y: auto;
    border: 1px #33363f;
}

/* A palette row: no opaque background -- the entity sprite is drawn over
   .palette-icon by the layer, a fill would cover it. Selection shows as a
   cyan left border (theme.rcss's accent), matching this project's
   .btn.selected treatment rather than a hover-only recolour. */
.palette-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    position: relative;
    height: 40px;
    box-sizing: border-box;
    padding: 4px;
    padding-left: 44px;
    border-bottom: 1px #262932;
    cursor: pointer;
}

.palette-row:hover .palette-name { color: #7ed6ff; }
.palette-row.selected { border-left: 3px #5cc8ff; }

.palette-icon {
    display: block;
    position: absolute;
    left: 6px;
    top: 4px;
    width: 32px;
    height: 32px;
}

.palette-name {
    display: inline-block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.palette-row.eraser .palette-name { color: #e5a15c; }

.fields-panel {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px #33363f;
    padding: 8px;
    margin-bottom: 6px;
}

.cell-head {
    display: block;
    color: #7ed6ff;
    padding: 2px 0 6px 0;
}

.prefab-name {
    display: inline-block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.prefab-edge {
    flex: 0 0 auto;
    width: auto;
}

.socket-edge, .socket-fallback {
    width: 100%;
}

.spawn-prefab, .spawn-wave {
    width: 100%;
}
