/* Piece Editor's own styles, beyond the shared List/Edit shell in
   content_editor.rcss (linked before this file) -- the palette, per-cell
   inspector, stamped-prefab row list, and per-cell socket row list. */

/* content_editor.rcss's .grid-column is a single-child block box (just
   #preview-window at 100%/100%), shared with Dungeon/Prefab. Piece adds an
   orientation-preview control above the preview window (see #field-preview
   in piece_editor.rml), so this document-scoped override (RCSS rules are
   per-document, not global -- Dungeon/Prefab load their own separate .rml
   with no equivalent link) turns it into a flex column instead, with the new
   row fixed-height and the preview window filling the rest. */
.grid-column {
    display: flex;
    flex-direction: column;
}

/* Anchor for .piece-toolbar/.painter-dropdown's position: absolute --
   content_editor.rcss's .edit-body has no position set (it's display: flex),
   which would otherwise anchor those to a further ancestor. */
#edit-body {
    position: relative;
}

#field-preview {
    flex: 0 0 auto;
    margin-bottom: 6px;
}

.preview-window {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
}

h3 .btn {
    margin-left: 8px;
}

/* Compact "+" add buttons for a socket's Tags/Connects To Tags lists --
   overrides theme.rcss's .btn { display: block; } (same specificity, later
   in the cascade) so they sit inline next to their h3 instead of forcing a
   full-width row. */
.add-socket-tag, .add-socket-connects {
    display: inline-block;
    width: 20px;
    padding: 0.3em 0;
    text-align: center;
}

/* One block-level wrapper around a socket row's fields/lists (see
   RefreshInspector) -- without it, those elements sit directly as children
   of .row-card-content (display: flex in field_widgets.rcss), where ones
   without an explicit full width (the h3 headers, the ref-scroll lists) size
   to their content and can land on the same flex line, overlapping instead
   of stacking. */
.socket-body {
    display: block;
    width: 100%;
}

.ref-scroll {
    display: block;
    width: 100%;
    box-sizing: border-box;
    max-height: 160px;
    overflow-y: auto;
    border: 1px #33363f;
    margin-bottom: 6px;
}

/* The generic field-label ("tag") is redundant here -- the socket's own
   "Tags"/"Connects To Tags" heading already says what the row holds.
   Hiding it (display: none, not just empty text) also drops it from
   .row-card-content's layout entirely, so the input becomes the row's only
   line and the drag-handle/remove-button (top-aligned via .row-card) land
   flush with it instead of the label line above. */
.tag-id .field-label {
    display: none;
}

/* #palette-list is gone (replaced by the floating painter dropdown), so
   .side-top is .side-column's only remaining child -- it now fills the
   column instead of capping at 55% with dead space below it. */
.side-top {
    flex: 1 1 auto;
    min-height: 0;
    box-sizing: border-box;
    overflow-y: auto;
}

/* Floating, draggable tool palette -- position: relative on #edit-body
   (below) is required for this position: absolute to anchor there instead
   of some further ancestor. Lives as a sibling of .grid-column/.side-column,
   not nested inside .grid-column, since that column clips overflow and
   would cut off a toolbar dragged near its edge. Its <img> icons (in
   piece_editor.rml) use "Assets/Icons/..." rather than "../Icons/..." --
   despite this document living in Assets/RML/, <img src> resolves relative
   to the process's working directory (the Editor's own targetdir, same as
   EditorFilepaths' non-Data paths), not relative to the document's own
   folder as RmlUi's JoinPath might suggest.

   left/top below are only the pre-layout fallback -- PositionToolbarDefault
   overwrites them (top-right corner of #preview-window) once #edit-body has
   a real laid-out size, on every fresh Edit-mode entry. Once positioned
   (default or user-dragged), later frames leave it alone. */
.piece-toolbar {
    position: absolute;
    left: 12px;
    top: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: #1c1e24;
    border: 1px #33363f;
    padding: 4px;
}

.piece-toolbar-handle {
    display: block;
    width: 14px;
    height: 28px;
    cursor: move;
    drag: drag;
    background-color: #33363f;
}

.piece-toolbar-handle:hover {
    background-color: #454a56;
}

.piece-tool-btn {
    display: block;
    width: 28px;
    height: 28px;
    box-sizing: border-box;
    padding: 5px;
    background-color: #262932;
    border: 1px #33363f;
    cursor: pointer;
}

.piece-tool-btn:hover {
    background-color: #2f333e;
    border-color: #454a56;
}

.piece-tool-btn.selected {
    background-color: #23303d;
    border-color: #5cc8ff;
}

.piece-tool-btn img {
    display: block;
    width: 16px;
    height: 16px;
}

/* Prefab picker for the Painter tool -- opens at the mouse position when the
   Painter tool is selected, positioned/sized by the layer in C++ (including
   the edge-flip logic to keep it on screen). Rows below reuse the same
   .palette-row/.palette-icon/.palette-name look #palette-list used to have.
   width/max-height are fixed (not just min-*) and must match
   kPainterDropdownWidth/kPainterDropdownMaxHeight in PieceEditorLayer.cpp --
   the layer positions this element using those constants rather than reading
   its live box size, to avoid a same-call pre-layout read. */
.painter-dropdown {
    position: absolute;
    width: 200px;
    min-height: 40px;
    max-height: 280px;
    box-sizing: border-box;
    overflow-y: auto;
    background-color: #1c1e24;
    border: 1px #33363f;
}

/* A palette row: no opaque background -- the entity sprite is drawn over
   .palette-icon by the layer, a fill would cover it. Selection shows as a
   cyan left border (theme.rcss's accent), matching this project's
   .btn.selected treatment rather than a hover-only recolour. */
.palette-row {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    position: relative;
    height: 40px;
    box-sizing: border-box;
    padding: 4px;
    padding-left: 44px;
    border-bottom: 1px #262932;
    cursor: pointer;
}

.palette-row:hover .palette-name { color: #7ed6ff; }
.palette-row.selected { border-left: 3px #5cc8ff; }

.palette-icon {
    display: block;
    position: absolute;
    left: 6px;
    top: 4px;
    width: 32px;
    height: 32px;
}

.palette-name {
    display: inline-block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.fields-panel {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px #33363f;
    padding: 8px;
    margin-bottom: 6px;
}

.cell-head {
    display: block;
    color: #7ed6ff;
    padding: 2px 0 6px 0;
}

.prefab-name {
    display: inline-block;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.prefab-edge {
    flex: 0 0 auto;
    width: auto;
}

.socket-edge, .socket-fallback {
    width: 100%;
}

.spawn-prefab, .spawn-wave {
    width: 100%;
}
