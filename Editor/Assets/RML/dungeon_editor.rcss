/* Dungeon Editor's own styles, beyond the shared List/Edit shell in
   content_editor.rcss and the shared row-card system in field_widgets.rcss
   (both linked before this file) -- just the piece-ref/lock list's scroll
   box and per-field widths. */

h3 .btn {
    margin-left: 8px;
}

.ref-scroll {
    display: block;
    width: 100%;
    box-sizing: border-box;
    max-height: 160px;
    overflow-y: auto;
    border: 1px #33363f;
    margin-bottom: 6px;
}

.ref-id, .ref-weight, .ref-max, .lock-type, .lock-count {
    flex: 1 1 auto;
    min-width: 0;
}
