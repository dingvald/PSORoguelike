/* Dungeon Editor's own styles, beyond the shared List/Edit shell in
   content_editor.rcss and the shared row-card/inspector-card system in
   field_widgets.rcss (both linked before this file) -- just the piece-ref/
   lock list's scroll box. Each entry is its own collapsible inspector card
   (see fieldwidgets::BuildCardList), so their field-rows stack full-width
   inside .inspector-card-body rather than needing a flex-item width rule. */

.ref-scroll {
    display: block;
    width: 100%;
    box-sizing: border-box;
    max-height: 160px;
    overflow-y: auto;
    border: 1px #33363f;
    margin-bottom: 6px;
}
