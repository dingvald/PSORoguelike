<rml>
    <head>
        <title>Piece Editor</title>
        <link type="text/rcss" href="theme.rcss"/>
        <link type="text/rcss" href="field_widgets.rcss"/>
        <link type="text/rcss" href="content_editor.rcss"/>
        <link type="text/rcss" href="piece_editor.rcss"/>
    </head>
    <body>
        <div id="screen-list" class="screen">
            <div class="toolbar">
                <h1>Pieces</h1>
                <span id="new-piece" class="btn action">New Piece</span>
                <span id="list-error" class="text-danger"></span>
                <span id="back-to-menu" class="btn back">Back</span>
            </div>
            <div id="piece-list" class="scroll-panel"></div>
        </div>

        <div id="screen-edit" class="screen">
            <div class="toolbar">
                <span id="edit-title" class="title text-accent"></span>
                <span id="save-piece" class="btn action">Save</span>
                <span id="edit-dirty" class="text-accent"></span>
                <span id="edit-error" class="text-danger"></span>
                <span id="back-to-list" class="btn back">Back</span>
            </div>
            <div id="edit-body" class="edit-body">
                <div class="grid-column">
                    <div id="field-preview" class="field-row"></div>
                    <div id="preview-window" class="preview-window"></div>
                </div>
                <div class="side-column">
                    <div class="side-top">
                        <h3>Id</h3>
                        <div id="field-id" class="field-row"></div>

                        <div id="details-card" class="inspector-card list-item">
                            <div class="inspector-card-header">
                                <span class="collapse-toggle">v</span>
                                <span class="component-title">Details</span>
                            </div>
                            <div class="inspector-card-body list-item-body">
                                <h3>Name</h3>
                                <div id="field-name" class="field-row"></div>
                                <h3>Area tag</h3>
                                <div id="field-area-tag" class="field-row"></div>
                                <h3>Category</h3>
                                <div id="field-category" class="field-row"></div>
                                <div id="field-can-rotate" class="field-row"></div>
                                <div id="field-can-mirror" class="field-row"></div>
                            </div>
                        </div>

                        <div id="tags-card" class="inspector-card list-item">
                            <div class="inspector-card-header">
                                <span class="collapse-toggle">v</span>
                                <span class="component-title">Tags</span>
                                <span id="add-tag" class="btn">+</span>
                            </div>
                            <div class="inspector-card-body list-item-body">
                                <div id="field-tags" class="ref-scroll"></div>
                            </div>
                        </div>

                        <div id="selected-cell-section">
                            <h3>Selected cell</h3>
                            <div id="cell-inspector" class="fields-panel"></div>
                        </div>
                    </div>
                </div>
                <div id="piece-toolbar" class="piece-toolbar">
                    <div id="piece-toolbar-handle" class="piece-toolbar-handle"></div>
                    <span id="tool-selector" class="piece-tool-btn"><img src="Assets/Icons/selector.png"/></span>
                    <span id="tool-painter" class="piece-tool-btn"><img src="Assets/Icons/painter.png"/></span>
                    <span id="tool-eraser" class="piece-tool-btn"><img src="Assets/Icons/eraser.png"/></span>
                </div>
                <div id="painter-dropdown" class="painter-dropdown" style="display: none;"></div>
            </div>
        </div>
    </body>
</rml>
