/* Structural rules for UI/FieldWidgets.h's builder set + the collapse-toggle
   list pattern. <link> this after theme.rcss in any document that uses these
   widgets -- colors/accents here defer to theme.rcss's palette (one cyan
   accent, consistent "selected" treatment) rather than hardcoding a second
   palette per screen, unlike the sibling toolkit this was ported from (every
   one of its editor screens redeclared this file's rules with its own
   gold/orange accent). */

.field-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
    padding: 3px 0;
}

.field-label {
    display: inline-block;
    flex-shrink: 0;
    width: 130px;
    color: #8a8f9c;
    vertical-align: middle;
}

input.field-input, input, select, .field-input {
    display: inline-block;
    background-color: #fff;
    color: #222;
    border: 2px #999;
    padding: 3px 5px;
    cursor: text;
    box-sizing: border-box;
    flex-shrink: 0;
    width: 200px;
    font-size: 0.9em;
    vertical-align: middle;
}

/* Overrides the generic input.field-input rule above (same 0,1,1 specificity
   -- tag + class each -- so later in the cascade wins): that rule's 200px
   width/text cursor fit text/number fields, but render a checkbox hugely
   oversized with no visible checked-state, since RmlUi has no built-in
   checkbox appearance of its own (see BuildBoolField). */
input.checkbox-input {
    width: 16px;
    height: 16px;
    padding: 0;
    cursor: pointer;
    background-color: #fff;
    border: 2px #999;
}

input.checkbox-input:hover {
    border: 2px #5cc8ff;
}

input.checkbox-input:checked {
    background-color: #23303d;
    border: 2px #5cc8ff;
}

/* Tag-qualified (not just the bare class) so these tie the base
   "input.field-input, input, select, .field-input" rule's specificity above
   and win via source order -- a bare ".field-input-small"/".field-input-hex"
   class selector is LOWER specificity than "input.field-input" (tag+class),
   so the base rule's width:200px was silently winning over these on any
   input carrying both classes (e.g. BuildVec2Field's x/y inputs,
   BuildColorField's hex input) -- functionally invisible until a narrow
   container (PrefabEditorLayer's 380px side-column) made the resulting
   200px-wide sub-fields overflow off the window entirely. */
input.field-input-small {
    width: 70px;
}

input.field-input-hex {
    width: 120px;
}

/* RmlUi's <select> has no built-in appearance for its internal selectarrow/
   selectvalue/selectbox elements or for <option> -- left unstyled, selectbox
   has no `position`, so it stays in normal document flow instead of floating
   as a popup: the widget's manually-computed screen offset gets discarded on
   the next layout pass, leaving the option list crammed into the flow
   (garbled) and effectively unclickable. */
select {
    position: relative;
    padding-right: 22px;
    cursor: pointer;
}

select selectvalue {
    display: block;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

select selectarrow {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 12px;
    height: 12px;
    background-color: #555;
}

select:hover selectarrow {
    background-color: #5cc8ff;
}

selectbox {
    position: absolute;
    display: block;
    min-width: 100%;
    max-height: 220px;
    box-sizing: border-box;
    background-color: #1c1e24;
    border: 2px #33363f;
}

selectbox option {
    display: block;
    padding: 4px 6px;
    color: #e6e8ec;
    cursor: pointer;
}

selectbox option:hover {
    background-color: #2f333e;
    color: #7ed6ff;
}

selectbox option:checked {
    background-color: #23303d;
}

.invalid {
    border: 2px #e5686b;
}

.texture-id-value {
    display: inline-block;
    flex-shrink: 0;
    width: 90px;
    color: #7ed6ff;
    vertical-align: middle;
}

.color-swatch {
    display: inline-block;
    flex-shrink: 0;
    width: 24px;
    height: 20px;
    border: 1px #33363f;
    vertical-align: middle;
    background-color: #000;
}

.collapse-toggle {
    display: inline-block;
    flex-shrink: 0;
    width: 22px;
    text-align: center;
    cursor: pointer;
    color: #8a8f9c;
}

.collapse-toggle:hover {
    color: #7ed6ff;
}

.list-item-body {
    display: block;
}

.list-item.collapsed .list-item-body {
    display: none;
}

/* Shared addable/removable row-list chrome (see fieldwidgets::BuildRowList)
   -- every editor's "list of things that can be added or removed" (Dungeon's
   piece-refs/locks, Prefab's race bonuses, Piece's per-cell stamped prefabs/
   sockets, ...) renders through this one row shape instead of each screen
   inventing its own, so add/remove/drag-reorder look and behave identically
   everywhere. */
/* align-items: flex-start (not center) -- most rows are a single line, where
   this makes no visible difference, but a row whose content spans multiple
   lines (e.g. a socket's stacked edge/fallback/tag-list fields, see
   piece_editor.rcss's .socket-body) needs its drag-handle/remove-button
   pinned to the top rather than floating to the vertical middle of the
   whole card, where they'd land on top of whatever inner content happens to
   sit at that height instead of the row's own edge. */
.row-card {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
    padding: 4px 6px;
    margin-bottom: 4px;
    background-color: #1c1e24;
    border: 1px #33363f;
    border-radius: 4px;
}

.row-card.dragging {
    opacity: 0.4;
}

.row-card.drag-over {
    border: 1px #5cc8ff;
}

.drag-handle {
    display: inline-block;
    flex-shrink: 0;
    width: 16px;
    text-align: center;
    color: #5a5f6b;
    cursor: move;
}

.drag-handle:hover {
    color: #8a8f9c;
}

.row-card-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    flex: 1 1 auto;
    min-width: 0;
}

.row-card-remove {
    flex-shrink: 0;
    padding: 2px 8px;
}

/* The fuller Unity-Inspector-style card, used only by Prefab Editor's
   component list on top of the .row-card visuals above (dragging/drag-over
   states are shared). Body collapse reuses .list-item/.list-item-body/
   .collapsed verbatim (see WireCollapseToggle) -- apply both ".inspector-card"
   and ".list-item" to the same element, no new collapse mechanism needed. */
.inspector-card {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 6px;
    background-color: #1c1e24;
    border: 1px #33363f;
    border-radius: 4px;
}

.inspector-card.dragging {
    opacity: 0.4;
}

.inspector-card.drag-over {
    border: 1px #5cc8ff;
}

.inspector-card-header {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
    padding: 6px 8px;
}

.component-icon {
    display: inline-block;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #5cc8ff;
}

.component-title {
    flex: 1 1 auto;
    min-width: 0;
    color: #e6e8ec;
}

.inspector-card-body {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 4px 10px 10px 10px;
    border-top: 1px #262932;
}

/* Styled to read as a full-width "Add Component" button (matching the plain
   .btn from theme.rcss, same grey every other button in this side column
   uses -- "Choose...", "Pick...", etc. -- not the cyan .action accent, which
   is reserved for the toolbar's Save button) while staying a real <select>
   underneath -- reuses BuildEnumField's mechanics rather than a bespoke
   popup/menu widget. Margin matches .inspector-card's own margin-bottom so
   it lines up exactly flush with the cards above it. */
#add-component-select {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin: 0 0 6px 0;
    background-color: #262932;
    color: #e6e8ec;
    border: 1px #33363f;
    padding: 0.3em 0.7em;
    text-align: center;
    cursor: pointer;
}

#add-component-select:hover {
    background-color: #2f333e;
    border-color: #454a56;
}
