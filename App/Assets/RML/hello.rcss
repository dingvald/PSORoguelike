body {
    font-family: "Pixel Code";
    color: #eee;
    background-color: transparent;
    width: 100%;
    height: 100%;
}

#hello-panel {
    display: block;
    position: absolute;
    top: 38%;
    left: 50%;
    width: 460px;
    margin-left: -230px;
    padding: 1.5em 1em;
    text-align: center;
    background-color: rgba(10, 8, 12, 190);
    border: 2px #f6470a;
}

h1 {
    display: block;
    color: #f6470a;
    font-size: 2em;
    font-weight: bold;
    margin-bottom: 0.6em;
}

p {
    display: block;
    color: #dddddd;
    font-size: 1em;
}
