body {
    font-family: "Pixel Code";
    color: #eee;
    background-color: #0d0b0e;
    width: 100%;
    height: 100%;
}

#menu-shell {
    display: flex;
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.panel {
    display: flex;
    flex-direction: column;
    width: 420px;
    text-align: center;
    background-color: rgba(20, 16, 18, 220);
    border: 2px #f6470a;
    padding: 1.5em;
}

#placeholder-panel {
    display: none;
}

h1 {
    display: block;
    font-size: 1.9em;
    font-weight: bold;
    color: #f6470a;
    margin-bottom: 0.3em;
}

.subtitle {
    display: block;
    color: #aaa;
    font-size: 0.85em;
    margin-bottom: 1.2em;
}

.menu-list {
    display: block;
}

.menu-row {
    display: block;
    padding: 0.6em 0.8em;
    margin: 0.2em 0;
    color: #ddd;
    background-color: transparent;
    border: 1px transparent;
}

.menu-row:hover {
    background-color: rgba(246, 71, 10, 60);
}

.menu-row.selected {
    background-color: rgba(246, 71, 10, 90);
    border: 1px #f6470a;
    color: #fff;
}

.menu-row.disabled {
    color: #555;
}

/* Shared by any dynamically-built row list whose rows carry more than a bare
   label (CharacterCreationLayer's class rows, CharacterSlotSelectLayer's
   per-slot rows) -- a bold title line plus a smaller dimmed description
   line, both inside one .menu-row. */
.row-title {
    display: block;
    font-weight: bold;
}

.row-desc {
    display: block;
    font-size: 0.75em;
    color: #aaa;
}
