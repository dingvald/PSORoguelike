<rml>
    <head>
        <title>PSORoguelike HUD</title>
        <link type="text/rcss" href="hud.rcss"/>
    </head>
    <body id="hud-body">
        <div id="bars">
            <div id="identity-row">
                <span id="level-text" class="level-text"></span>
                <span id="name-text" class="name-text">Player</span>
            </div>
            <div class="bar-row">
                <span class="bar-label">HP</span>
                <div class="bar-track"><div id="hp-fill" class="bar-fill hp"></div></div>
                <span id="hp-text" class="bar-text"></span>
            </div>
            <div id="secondary-row" class="bar-row">
                <span class="bar-label">TP</span>
                <div class="bar-track"><div id="secondary-fill" class="bar-fill secondary"></div></div>
                <span id="secondary-text" class="bar-text"></span>
            </div>
            <div id="status-effects"></div>
        </div>

        <div id="hotbar">
            <div id="hotbar-slot-0" class="hotbar-slot"><span class="slot-key">1</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-1" class="hotbar-slot"><span class="slot-key">2</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-2" class="hotbar-slot"><span class="slot-key">3</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-3" class="hotbar-slot"><span class="slot-key">4</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-4" class="hotbar-slot"><span class="slot-key">5</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-5" class="hotbar-slot"><span class="slot-key">6</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-6" class="hotbar-slot"><span class="slot-key">7</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-7" class="hotbar-slot"><span class="slot-key">8</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-8" class="hotbar-slot"><span class="slot-key">9</span><span class="slot-name"></span></div>
            <div id="hotbar-slot-9" class="hotbar-slot"><span class="slot-key">0</span><span class="slot-name"></span></div>
        </div>

        <div id="target-panel">
            <span id="target-name" class="target-name"></span>
            <span id="target-race" class="target-race"></span>
            <div class="bar-row">
                <div class="bar-track"><div id="target-hp-fill" class="bar-fill target"></div></div>
            </div>
        </div>

        <div id="hub-interaction-prompt"></div>

        <div id="event-log"></div>

        <div id="floating-text-layer"></div>

        <div id="game-over">
            <div id="game-over-text">YOU DIED</div>
            <div id="game-over-hint">Press any key to restart</div>
        </div>

        <div id="character-screen">
            <div id="character-screen-title">Character</div>
            <div id="character-screen-columns">
                <div id="character-screen-stats" class="character-screen-panel"></div>
                <div id="character-screen-equipment" class="character-screen-panel"></div>
                <div id="character-screen-inventory" class="character-screen-panel"></div>
            </div>
            <div id="character-screen-mag-panel"></div>
            <div id="character-screen-item-detail"></div>
            <div id="character-screen-context-menu"></div>
            <div id="character-screen-hint">Numpad to navigate, Space to select, C / Esc to close</div>
        </div>

        <div id="action-palette">
            <div id="action-palette-title">Action Palette</div>
            <div id="action-palette-columns">
                <div id="action-palette-normal-attack" class="character-screen-panel"></div>
                <div id="action-palette-special-attack" class="character-screen-panel"></div>
                <div id="action-palette-techniques" class="character-screen-panel"></div>
                <div id="action-palette-photon-arts" class="character-screen-panel"></div>
            </div>
            <div id="action-palette-hint">Numpad to navigate, Space to assign to hotbar, P / Esc to close</div>
        </div>

        <div id="mission-select-screen">
            <div id="mission-select-title">Mission Select</div>
            <div id="mission-select-list"></div>
            <div id="mission-select-hint">Numpad to navigate, Space to select, Esc to close</div>
        </div>

        <div id="shop-screen">
            <div id="shop-title">Shop</div>
            <div id="shop-meseta"></div>
            <div id="shop-columns">
                <div id="shop-stock-list" class="character-screen-panel"></div>
                <div id="shop-sellable-list" class="character-screen-panel"></div>
            </div>
            <div id="shop-hint">Numpad to navigate, Space to buy/sell, Esc to close</div>
        </div>

        <div id="storage-screen">
            <div id="storage-title">Storage</div>
            <div id="storage-columns">
                <div id="storage-inventory-list" class="character-screen-panel"></div>
                <div id="storage-storage-list" class="character-screen-panel"></div>
            </div>
            <div id="storage-hint">Numpad to navigate, Space to store/withdraw, Esc to close</div>
        </div>

        <div id="pause-screen">
            <div id="pause-menu-panel">
                <div id="pause-screen-title">Paused</div>
                <div id="pause-screen-list">
                    <div id="pause-row-resume" class="mission-row">Resume</div>
                    <div id="pause-row-options" class="mission-row">Options</div>
                    <div id="pause-row-help" class="mission-row">Help</div>
                    <div id="pause-row-quit-title" class="mission-row">Quit to Title</div>
                    <div id="pause-row-quit-desktop" class="mission-row">Quit to Desktop</div>
                </div>
                <div id="pause-screen-hint">Numpad to navigate, Space to select, Esc to resume</div>
            </div>
            <div id="pause-placeholder-panel">
                <div id="pause-placeholder-title"></div>
                <div id="pause-placeholder-text">Coming Soon</div>
                <div id="pause-placeholder-hint">Space / Esc to go back</div>
            </div>
        </div>

        <div id="confirm-dialog">
            <div id="confirm-dialog-message"></div>
            <div id="confirm-dialog-list">
                <div id="confirm-row-yes" class="mission-row">Yes</div>
                <div id="confirm-row-no" class="mission-row">No</div>
            </div>
            <div id="confirm-dialog-hint">Numpad to navigate, Space to select, Esc to cancel</div>
        </div>

        <div id="tile-tooltip"></div>
    </body>
</rml>
