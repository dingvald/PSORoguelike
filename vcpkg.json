{
  "name": "psoroguelike",
  "version": "0.1.0",
  "description": "PSO-inspired turn-based roguelike + engine (C++23, SDL3, RmlUi)",
  "dependencies": [
    "sdl3",
    {
      "name": "sdl3-image",
      "features": [
        "png"
      ]
    },
    "freetype",
    {
      "name": "rmlui",
      "features": [
        "freetype"
      ]
    },
    "entt",
    "catch2"
  ]
}
